# Obligatoire : code d'accès à l'interface d'Olivier (/admin). Choisir une longue phrase.
ADMIN_TOKEN=
PORT=3000
DB_PATH=./data/littleitaly.db

# Paiement en ligne (facultatif : sans ces clés, seul "au retrait" est proposé)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications sur le téléphone d'Olivier (écran /admin installé) : adresse de contact exigée par le service d'envoi.
# Les clés sont créées automatiquement et conservées dans la base. Exige HTTPS en production.
VAPID_SUBJECT=mailto:contact@votre-restaurant.fr
